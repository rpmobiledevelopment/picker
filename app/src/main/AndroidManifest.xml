<!--            android:name="pickerMultiple.ImgSelectMultipleAct"-->
<!--            android:theme="@style/Theme.AppCompat.Light.Dialog" />-->
<!--        <activity android:name="multipleImgPick.ui.PickerActivity" />-->

<!--        <service-->
<!--            android:name="multipleImgPick.util.OfflineSpiceService"-->
<!--            android:exported="false" />-->
    </application>
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*"/>
        </intent>
    </queries>

</manifest>